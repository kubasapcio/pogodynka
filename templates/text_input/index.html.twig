{% extends 'base.html.twig' %}
{% block title %}Text TextInputController!{% endblock %}

{% block body %}
    <h1>Formularz tekstowy</h1>

    {{ form_start(form) }}
    {{ form_widget(form) }}
    <button type="submit">{{ button_label|default('Wyślij') }}</button>
    {{ form_end(form) }}

    {% if submittedText is not empty %}
        <h2>Wprowadzony tekst:</h2>
        <p>{{ submittedText.text }}</p>
        <p>{{ submittedText.text|raw }}</p>
    {% endif %}
{% endblock %}
